    <string name="about_title">About Qupa</string>
    <string name="about_how">Phones are the buzzers. Scan the code, type a nickname and play in the phone\'s browser: no app, no account. The TV serves the game over your home network, so nothing goes through the internet.</string>
    <string name="about_attribution">Questions from the Open Trivia Database (opentdb.com), CC BY-SA 4.0</string>
    <string name="about_privacy">No ads, no accounts, no tracking. Nicknames stay in memory on the TV during a game.</string>
